/*
 * Copyright (c) 2026 Vincent Franco
 * SPDX-License-Identifier: MIT
 *
 * Shared by every Bridges V2 build target: both halves and the dongle.
 * Nothing here assumes which device is the split central.
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include "layout_54.dtsi"
#include "layout_42.dtsi"
#include "layout_36.dtsi"

&measlesbagel_bridges_54_layout {
  transform = <&default_transform>;
};

&measlesbagel_bridges_42_layout {
  transform = <&forty_two_transform>;
};

&measlesbagel_bridges_36_layout {
  transform = <&thirty_six_transform>;
};

/ {
    chosen {
      zmk,physical-layout = &measlesbagel_bridges_54_layout;
    };

    default_transform: keymap_transform0 {
      compatible = "zmk,matrix-transform";
      columns = <12>;
      rows = <5>;
      map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)       RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)       RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)       RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)       RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                                RC(4,3) RC(4,4) RC(4,5)       RC(4,6) RC(4,7) RC(4,8)
      >;
    };

    forty_two_transform: keymap_transform1 {
      compatible = "zmk,matrix-transform";
      columns = <12>;
      rows = <5>;
      map = <
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)       RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)       RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)       RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                                RC(4,3) RC(4,4) RC(4,5)       RC(4,6) RC(4,7) RC(4,8)
      >;
    };

    thirty_six_transform: keymap_transform2 {
      compatible = "zmk,matrix-transform";
      columns = <12>;
      rows = <5>;
      map = <
        RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)           RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
        RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)           RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
        RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)           RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10)
                        RC(4,3) RC(4,4) RC(4,5)           RC(4,6) RC(4,7) RC(4,8)
      >;
    };

    /*
     * One split input channel per side. The split register is the
     * channel's identity on the central, whatever device the central is:
     * left is always 0 and right is always 1.
     *
     * Each half enables its own channel and points it at its sensor, so
     * that half's firmware is the same whichever device is central. The
     * central enables the channel of every half it receives from. Both stay
     * disabled here: a peripheral must not enable a channel that has no
     * local sensor.
     */
    split_inputs {
      #address-cells = <1>;
      #size-cells = <0>;

      trackball_left_split: trackball_left_split@0 {
        compatible = "zmk,input-split";
        reg = <0>;
        status = "disabled";
      };

      trackball_right_split: trackball_right_split@1 {
        compatible = "zmk,input-split";
        reg = <1>;
        status = "disabled";
      };
    };

    /*
     * Where each ball's motion enters the central. They default to the
     * split channels (the ball is on another device). A half that is
     * central points its own ball's listener at its local sensor instead.
     * Only the central enables them. Configs attach input processors here.
     */
    trackball_left_listener: trackball_left_listener {
      compatible = "zmk,input-listener";
      status = "disabled";
      device = <&trackball_left_split>;
    };

    trackball_right_listener: trackball_right_listener {
      compatible = "zmk,input-listener";
      status = "disabled";
      device = <&trackball_right_split>;
    };
};
